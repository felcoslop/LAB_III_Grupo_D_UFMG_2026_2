 "esquematico": {
  "_nota": "Diferenças entre o esquema do Fritzing (SUMO_Esquemático e SUMO_bb) e o firmware (config.h) e o documento de ligação (Lab3-Liga). A montagem segue o firmware.",
  "diferencas": [
   {
    "item": "Sensores de borda",
    "fritzing": "saída D0 dos módulos nos GPIO 36 (VP), 39 (VN), 34 e 35",
    "firmware": "saída A0 (analógica) nos GPIO 34, 35, 32 e 33 (BFE, BFD, BTE, BTD)",
    "porque": "o firmware mede a tensão para separar a faixa branca de arranhão e poeira; o D0 só dá 0 ou 3,3 V"
   },
   {
    "item": "Chave DIP",
    "fritzing": "vias nos GPIO 15, 14, 33 e 32, com o comum no GND",
    "firmware": "vias nos GPIO 12, 14, 2 e 15, com o comum no 3V3",
    "porque": "o firmware liga o pull-down interno e lê 1 com a via ligada; com o comum no GND a chave nunca muda a leitura, e os GPIO 32 e 33 são dos sensores de borda"
   },
   {
    "item": "Botão de start (S1)",
    "fritzing": "entre o GPIO 2 e o GND",
    "firmware": "GPIO 0, o mesmo do botão BOOT da placa",
    "porque": "o GPIO 2 é a via 3 da chave DIP; o DevKit de 30 pinos não tem o GPIO 0 na barra, então o start é o próprio botão BOOT (ou um botão soldado em paralelo com ele)"
   },
   {
    "item": "Ponte H",
    "fritzing": "módulo L298N",
    "firmware": "módulo HW-956 de MOSFET (entradas GND, IN1 a IN4), PWM de até 2 kHz",
    "porque": "mesmas ligações de IN1 a IN4 nos GPIO 25, 26, 27 e 13; o L298N do Fritzing só representa o módulo"
   },
   {
    "item": "Alimentação dos motores",
    "fritzing": "P+ e P- do BMS direto na ponte H, sem chave",
    "firmware": "-",
    "porque": "sem chave, a ponte H fica sempre ligada à bateria 3S; uma chave de 5 A no P+ desliga os motores com o robô parado"
   },
   {
    "item": "Ligação ao ESP32",
    "fritzing": "jumpers do ESP32 na protoboard",
    "firmware": "-",
    "porque": "o DevKit vai na extensora (trios S, V e G de cada GPIO), na prateleira; não há protoboard: o SDA e o SCL dos sete VL53L0X se juntam em duas emendas soldadas, cada uma com um jumper curto até o pino S do GPIO 21 ou 22"
   }
  ]
 }
